{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "// targets": "to see all targets run: nx show project shared --web",
  "targets": {
    "generate-schemas": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/schemas/src/generated/**"],
      "options": {
        "commands": [
          "dts-bundle-generator --no-check -o dist/libs/shared/dto.d.ts libs/shared/src/dto/index.ts",
          "node tools/src/generate-schemas.js --input dist/libs/shared/dto.d.ts --output libs/shared/src/schema/generated.ts",
          "npx prettier --write libs/shared/src/schema/generated.ts"
        ],
        "parallel": false,
        "cwd": "."
      }
    }
  }
}
